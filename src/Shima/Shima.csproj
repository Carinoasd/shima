<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\shima.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Shima</RootNamespace>
    <AssemblyName>Shima</AssemblyName>
    <Version>0.6.0</Version>
    <Product>Shima</Product>
    <Authors>Carinoasd</Authors>
    <Company>Carinoasd</Company>
    <Copyright>(C) 2026 Carinoasd</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\strings.tsv" LogicalName="Shima.Assets.strings.tsv" />
    <EmbeddedResource Include="..\..\streamdock\com.carinoasd.shima.sdPlugin\*" LogicalName="Shima.StreamDock.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms 只用來做系統匣圖示；它的名稱不要蓋到 WPF 的 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.12.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="System.Management" Version="11.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

</Project>
