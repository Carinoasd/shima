<Window x:Class="Shima.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Shima"
        Title="Shima" Width="560" Height="312"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Microsoft JhengHei UI, Segoe UI"
        Foreground="White" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <Style x:Key="Key" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="18">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#80FFFFFF"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="Tabs"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="15">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Pill" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#26FFFFFF"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Opacity" Value="0.82"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <DockPanel Background="Transparent">
              <Border x:Name="Track" DockPanel.Dock="Right" Width="36" Height="20" CornerRadius="10" Background="#33FFFFFF" VerticalAlignment="Center">
                <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,3,0"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center" Margin="2,0,0,0"/>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#D97757"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Input" TargetType="TextBox">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bg" Background="#1FFFFFFF" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10" Padding="10,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#2BFFFFFF"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#2BFFFFFF"/>
                <Setter TargetName="Bg" Property="BorderBrush" Value="#80FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Field" TargetType="PasswordBox">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border Background="#1FFFFFFF" CornerRadius="10" Padding="10,0">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid x:Name="Host" Width="96" Height="36" Margin="0,8,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
          MouseEnter="Host_MouseEnter" MouseLeave="Host_MouseLeave"
          MouseLeftButtonDown="Host_MouseLeftButtonDown" MouseMove="Host_MouseMove" MouseLeftButtonUp="Host_MouseLeftButtonUp">
      <Grid.ContextMenu>
        <ContextMenu>
          <MenuItem x:Name="CharacterMenu" Header="角色"/>
          <MenuItem x:Name="SecondLineMenu" Header="歌詞第二行"/>
          <MenuItem Header="這首歌的歌詞">
            <MenuItem Header="換一份" Click="LyricsOther_Click"/>
            <MenuItem Header="提早 0.1 秒" Click="LyricsEarlier_Click"/>
            <MenuItem Header="延後 0.1 秒" Click="LyricsLater_Click"/>
            <MenuItem Header="還原" Click="LyricsReset_Click"/>
          </MenuItem>
          <MenuItem Header="複製歌詞卡片" Click="LyricCard_Click"/>
          <MenuItem Header="收藏這句歌詞" Click="Favorite_Click"/>
          <MenuItem Header="解釋這句歌詞" Click="ExplainLine_Click"/>
          <MenuItem x:Name="DesktopLyricsItem" Header="桌面歌詞" IsCheckable="True" Click="DesktopLyrics_Click"/>
          <MenuItem x:Name="DesktopLockItem" Header="鎖定桌面歌詞" IsCheckable="True" Click="DesktopLock_Click"/>
          <MenuItem Header="開啟歌詞資料夾" Click="LyricsFolder_Click"/>
          <MenuItem Header="回到螢幕正中間" Click="ResetPlace_Click"/>
          <MenuItem Header="結束" Click="Quit_Click"/>
        </ContextMenu>
      </Grid.ContextMenu>

      <!-- 陰影獨立一層，島裡面的文字變動時不用重算模糊 -->
      <Border x:Name="Shadow" Background="Black" CornerRadius="18" IsHitTestVisible="False">
        <Border.Effect>
          <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.4" Color="Black"/>
        </Border.Effect>
      </Border>

      <Border x:Name="Body" Background="Black" CornerRadius="18">
        <Grid x:Name="Inside">

          <!-- 展開時的背景：封面放大到糊掉，再壓暗 -->
          <Grid x:Name="Backdrop" Opacity="0" IsHitTestVisible="False">
            <Border x:Name="BackdropImage" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border Background="#B4000000"/>
            <s:SpectrumView x:Name="Spectrum" Height="110" VerticalAlignment="Bottom"/>
          </Grid>

          <!-- 收合：封面 + 一行字 -->
          <Grid x:Name="Pill" Height="36" VerticalAlignment="Top" Margin="7,0,8,0" Background="Transparent" MouseWheel="Pill_MouseWheel" MouseDown="Pill_MouseDown">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <s:Bars x:Name="Meter" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
              <s:Mascot x:Name="Buddy" Margin="5,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Border x:Name="PillCover" Width="22" Height="22" CornerRadius="6" Margin="0,0,9,0" Background="#2A2A2A"
                    VerticalAlignment="Center" Visibility="Collapsed"/>
            <s:KaraokeLine x:Name="PillLine" Grid.Column="1" Size="12.5" Height="24" VerticalAlignment="Center"/>
          </Grid>

          <!-- 展開 -->
          <Grid x:Name="Panel" Width="408" Margin="16,12,16,16" HorizontalAlignment="Center" VerticalAlignment="Top"
                Opacity="0" IsHitTestVisible="False" PreviewMouseDown="Panel_PreviewMouseDown">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="Tabs" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
              <RadioButton x:Name="TabMusic" Style="{StaticResource Tab}" Content="&#xE8D6;" ToolTip="音樂" IsChecked="True" Checked="Tab_Checked"/>
              <RadioButton x:Name="TabChat" Style="{StaticResource Tab}" Content="&#xE8BD;" ToolTip="聊天" Checked="Tab_Checked"/>
              <RadioButton x:Name="TabTools" Style="{StaticResource Tab}" Content="&#xE823;" ToolTip="工具" Checked="Tab_Checked"/>
              <RadioButton x:Name="TabLibrary" Style="{StaticResource Tab}" Content="&#xE8F1;" ToolTip="聆聽" Checked="Tab_Checked"/>
              <RadioButton x:Name="TabAi" Style="{StaticResource Tab}" Content="&#xE720;" ToolTip="AI" Checked="Tab_Checked"/>
              <RadioButton x:Name="TabSettings" Style="{StaticResource Tab}" Content="&#xE713;" ToolTip="設定" Checked="Tab_Checked"/>
            </StackPanel>

            <!-- 音樂 -->
            <StackPanel x:Name="WelcomeHost" Grid.Row="1" Visibility="Collapsed"/>
            <Grid x:Name="MusicPage" Grid.Row="2" Background="Transparent" MouseWheel="Music_MouseWheel">
              <Grid.RowDefinitions>
                <RowDefinition Height="84"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="84"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Cover" CornerRadius="12" Background="#2A2A2A"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="ArtistText" FontSize="13" Foreground="#B8FFFFFF" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="SourceText" FontSize="11" Foreground="#70FFFFFF" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                           Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Source_Click"/>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="40"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Elapsed" FontSize="11" Foreground="#90FFFFFF" VerticalAlignment="Center"/>
                <Grid x:Name="Bar" Grid.Column="1" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="Bar_MouseLeftButtonDown">
                  <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/>
                  <Border x:Name="BarFill" Height="4" CornerRadius="2" Background="White" VerticalAlignment="Center"
                          HorizontalAlignment="Left" Width="0"/>
                </Grid>
                <TextBlock x:Name="Remaining" Grid.Column="2" FontSize="11" Foreground="#90FFFFFF" VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
              </Grid>

              <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource Key}" Content="&#xE892;" Click="Previous_Click"/>
                <Button x:Name="PlayButton" Style="{StaticResource Key}" FontSize="18" Width="52" Content="&#xE768;" Click="Play_Click"/>
                <Button Style="{StaticResource Key}" Content="&#xE893;" Click="Next_Click"/>
                <Button x:Name="FavoriteButton" Style="{StaticResource Key}" FontSize="13" Content="&#xEB51;" ToolTip="收藏這句歌詞" Click="Favorite_Click"/>
                <Button x:Name="QueueButton" Style="{StaticResource Key}" FontSize="13" Content="&#xE8FD;" ToolTip="接下來播放" Click="Queue_Click"/>
              </StackPanel>

              <Grid x:Name="QueueHost" Grid.Row="5" Margin="0,10,0,0" Height="300" Visibility="Collapsed"/>
              <StackPanel x:Name="LyricsBox" Grid.Row="5" Margin="0,10,0,0" Visibility="Collapsed">
                <s:LyricsView x:Name="LyricsList" Height="150"/>
            </StackPanel>
            </Grid>

            <!-- 聊天：內嵌網頁版，登入一次就好 -->
            <Grid x:Name="ChatPage" Grid.Row="2" Height="560" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <StackPanel x:Name="ChatSites" Orientation="Horizontal" HorizontalAlignment="Center"/>
              <Border x:Name="ChatHost" Grid.Row="2" CornerRadius="12" Background="#1A1A1A"/>
            </Grid>

            <!-- AI：語音助手、API 金鑰、Claude Code -->
            <StackPanel x:Name="LibraryPage" Grid.Row="2" Visibility="Collapsed"/>

            <StackPanel x:Name="AiPage" Grid.Row="2" Visibility="Collapsed">
              <StackPanel x:Name="SessionsHost"/>
              <Grid Height="52">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="52"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="VoiceButton" Style="{StaticResource Key}" Width="52" Height="52" FontSize="20" Content="&#xE720;" ToolTip="語音助手" Click="Voice_Click"/>
                <TextBox x:Name="AskBox" Grid.Column="2" Style="{StaticResource Input}" Height="34" KeyDown="AskBox_KeyDown" ToolTip="問 AI，按 Enter"/>
              </Grid>
              <WrapPanel x:Name="ExamplesBox" Margin="0,10,0,-4"/>
              <TextBlock x:Name="VoiceText" FontSize="13" Foreground="#D0FFFFFF" TextWrapping="Wrap" MaxHeight="150" TextTrimming="CharacterEllipsis" Margin="4,10,4,0" Visibility="Collapsed"/>
              <DockPanel Height="30" Margin="0,12,0,0">
                <Button x:Name="ServiceButton" DockPanel.Dock="Left" Style="{StaticResource Pill}" Height="28" Padding="12,0" ToolTip="AI 服務" Click="Service_Click"/>
                <Button x:Name="ModelButton" Style="{StaticResource Pill}" Height="28" Padding="12,0" Margin="8,0,0,0" HorizontalAlignment="Left" MaxWidth="290" ToolTip="模型" Click="Model_Click"/>
              </DockPanel>
              <TextBox x:Name="UrlBox" Style="{StaticResource Input}" Height="30" Margin="0,8,0,0" LostKeyboardFocus="Url_LostKeyboardFocus" KeyDown="Url_KeyDown" ToolTip="API 網址（OpenAI 相容，結尾到 /v1）" Visibility="Collapsed"/>
              <Grid x:Name="KeyRow" Height="32" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8D7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="#90FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="API 金鑰"/>
                <PasswordBox x:Name="ApiKeyBox" Grid.Column="1" Style="{StaticResource Field}" PasswordChanged="ApiKey_Changed" ToolTip="API 金鑰"/>
              </Grid>
              <Grid Height="36" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DockPanel VerticalAlignment="Center" Margin="6,0,10,0">
                  <TextBlock DockPanel.Dock="Left" Text="Claude Code" FontSize="13"/>
                  <TextBlock x:Name="PlanText" FontSize="12" Foreground="#90FFFFFF" Margin="10,1,0,0" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                  <Button x:Name="RulesButton" Style="{StaticResource Pill}" Height="26" Padding="10,0" Margin="0,0,8,0" ToolTip="以後都允許" Visibility="Collapsed" Click="Rules_Click"/>
                  <Button x:Name="AgentButton" Style="{StaticResource Pill}" Content="連接" Click="Agent_Click"/>
                </StackPanel>
              </Grid>
              <StackPanel x:Name="RulesBox" Visibility="Collapsed" Margin="0,6,0,0"/>
              <StackPanel x:Name="OtherAgentsBox"/>
            </StackPanel>

            <!-- 工具：番茄鐘、暫存架、待辦 -->
            <StackPanel x:Name="ToolsPage" Grid.Row="2" Visibility="Collapsed">
              <Grid Height="44">
                <TextBlock x:Name="TimerText" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="TimerButton" Style="{StaticResource Key}" Content="&#xE768;" ToolTip="開始／暫停" Click="Timer_Click"/>
                  <Button Style="{StaticResource Key}" Content="&#xE72C;" ToolTip="重來" Click="TimerReset_Click"/>
                </StackPanel>
              </Grid>
              <Border CornerRadius="12" Background="#14FFFFFF" Margin="0,10,0,0" Padding="8,8,2,2" MinHeight="44">
                <Grid>
                  <TextBlock x:Name="ShelfHint" Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="#50FFFFFF"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,6,6" ToolTip="把檔案拖到島上暫放"/>
                  <WrapPanel x:Name="ShelfBox"/>
                </Grid>
              </Border>
              <StackPanel x:Name="TodoBox" Margin="0,10,0,0"/>
              <TextBox x:Name="TodoInput" Style="{StaticResource Input}" Height="30" Margin="0,6,0,0" KeyDown="TodoInput_KeyDown" ToolTip="新增待辦，按 Enter"/>
              <TextBlock x:Name="MonthTitle" FontSize="13" FontWeight="SemiBold" Margin="6,14,0,2"/>
              <s:MonthView x:Name="Month"/>
            </StackPanel>

            <!-- 設定 -->
            <ScrollViewer x:Name="SettingsPage" Grid.Row="2" Visibility="Collapsed" MaxHeight="540" VerticalScrollBarVisibility="Hidden" Focusable="False">
            <StackPanel>
              <DockPanel Height="32" Margin="2,0,0,2">
                <Button x:Name="LanguageButton" DockPanel.Dock="Right" Style="{StaticResource Pill}" Height="26" Padding="12,0" Click="Language_Click"/>
                <TextBlock Text="語言" FontSize="13" VerticalAlignment="Center"/>
              </DockPanel>
              <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Content="開機時啟動" Click="Switch_Click"/>
              <CheckBox x:Name="FullscreenSwitch" Style="{StaticResource Switch}" Content="全螢幕時隱藏" Click="Switch_Click"/>
              <CheckBox x:Name="AudioSwitch" Style="{StaticResource Switch}" Content="跟著聲音動" Click="Switch_Click"/>
              <CheckBox x:Name="NotifySwitch" Style="{StaticResource Switch}" Content="顯示訊息通知" Click="Notify_Click"/>
              <CheckBox x:Name="DeckSwitch" Style="{StaticResource Switch}" Content="Stream Dock" Click="Deck_Click"/>
              <CheckBox x:Name="SystemSwitch" Style="{StaticResource Switch}" Content="顯示音量、電量、網路的變化" Click="Switch_Click"/>
              <CheckBox x:Name="UpdateSwitch" Style="{StaticResource Switch}" Content="檢查新版" Click="Switch_Click"/>
              <CheckBox x:Name="DictationSwitch" Style="{StaticResource Switch}" Content="語音辨識用 Windows 的聽寫" Click="Switch_Click"/>
              <DockPanel Height="32">
                <TextBlock DockPanel.Dock="Right" Text="分鐘" FontSize="12" Foreground="#90FFFFFF" VerticalAlignment="Center" Margin="5,0,0,0"/>
                <TextBox x:Name="WaterBox" DockPanel.Dock="Right" Style="{StaticResource Input}" Height="26" Width="52" Margin="8,0,0,0" LostKeyboardFocus="SettingsText_LostKeyboardFocus" KeyDown="SettingsText_KeyDown" ToolTip="每隔幾分鐘"/>
                <CheckBox x:Name="WaterSwitch" Style="{StaticResource Switch}" Content="喝水提醒" Click="Switch_Click"/>
              </DockPanel>
              <StackPanel x:Name="MoreSettings"/>
              <TextBlock Text="歌詞來源" FontSize="12" Foreground="#90FFFFFF" Margin="2,10,0,6"/>
              <WrapPanel x:Name="SourcesBox"/>
              <DockPanel Margin="2,12,0,6">
                <Button DockPanel.Dock="Right" Style="{StaticResource Pill}" Height="24" Padding="10,0" Content="加入" Click="AddFolder_Click"/>
                <TextBlock Text="歌詞資料夾" FontSize="12" Foreground="#90FFFFFF" VerticalAlignment="Center"/>
              </DockPanel>
              <StackPanel x:Name="FoldersBox"/>
              <TextBlock Text="Discord Application ID" FontSize="12" Foreground="#90FFFFFF" Margin="2,8,0,6"/>
              <TextBox x:Name="DiscordBox" Style="{StaticResource Input}" Height="30" LostKeyboardFocus="SettingsText_LostKeyboardFocus" KeyDown="SettingsText_KeyDown"/>
              <TextBlock Text="番茄鐘：專注／休息（分鐘）" FontSize="12" Foreground="#90FFFFFF" Margin="2,12,0,6"/>
              <StackPanel Orientation="Horizontal">
                <TextBox x:Name="FocusBox" Style="{StaticResource Input}" Height="30" Width="64" LostKeyboardFocus="SettingsText_LostKeyboardFocus" KeyDown="SettingsText_KeyDown"/>
                <TextBox x:Name="BreakBox" Style="{StaticResource Input}" Height="30" Width="64" Margin="8,0,0,0" LostKeyboardFocus="SettingsText_LostKeyboardFocus" KeyDown="SettingsText_KeyDown"/>
              </StackPanel>
            </StackPanel>
            </ScrollViewer>

            <!-- Claude Code 在問可不可以 -->
            <StackPanel x:Name="AskPage" Grid.Row="2" Margin="0,4,0,0" Visibility="Collapsed">
              <TextBlock x:Name="AskTitle" FontSize="13" Foreground="#B8FFFFFF" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="AskTool" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
              <Border CornerRadius="10" Background="#1A1A1A" Margin="0,8,0,0" Padding="10,8">
                <TextBlock x:Name="AskDetails" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#D0FFFFFF" TextWrapping="Wrap" MaxHeight="96" TextTrimming="CharacterEllipsis"/>
              </Border>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="AskAlways" Style="{StaticResource Pill}" Margin="0,0,8,0" Visibility="Collapsed" Click="AskAlways_Click"/>
                <Button Style="{StaticResource Pill}" Content="回終端機" Click="AskTerminal_Click"/>
                <Button Style="{StaticResource Pill}" Content="拒絕" Margin="8,0,0,0" Click="AskDeny_Click"/>
                <Button Style="{StaticResource Pill}" Content="允許" Margin="8,0,0,0" Background="White" Foreground="Black" Click="AskAllow_Click"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
